pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/Rohan100898/ECU-log-test.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build stage"
            }
        }

        stage('Test') {
            steps {
                bat '''
                echo Checking Python...
                "C:\\Users\\Acer\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" --version

                echo Installing dependencies...
                "C:\\Users\\Acer\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" -m pip install -r requirement.txt

                echo Running tests...
                "C:\\Users\\Acer\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" -m pytest --html=ECU_Test_Report.html --self-contained-html
                '''
            }
        }

        stage('Test in Docker') {
            steps {
                bat 'wsl docker build -t ecu-log-test .'
                bat 'wsl docker run ecu-log-test'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                echo Deploying application...
                mkdir "D:\\Workspace\\Deployed_projects\\ECU-log-test"
                xcopy /E /I /Y * "D:\\Workspace\\Deployed_projects\\ECU-log-test"
                '''
            }
        }
    }
}