pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/Rohan100898/ECU-log-test.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build stage"
            }
        }

        stage('Test') {
            steps {
                bat '"C:\\Users\\Acer\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" -m pytest --html=ECU_Test_Report.html --self-contained-html'
            }
        }

        stage('Test in Docker') {
            steps {
                bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" build -t ecu-log-test .'
                bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" run ecu-log-test'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                echo Deploying application...
                mkdir "D:\\Workspace\\Deployed_projects\\ECU-log-test"
                xcopy /E /I /Y * "D:\\Workspace\\Deployed_projects\\ECU-log-test"
                '''
            }
        }
    }
}